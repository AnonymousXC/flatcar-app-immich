variant: flatcar
version: 1.1.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZ.......... your@email

storage:
  directories:
    - path: /var/lib/immich
      mode: 0755
      overwrite: true
    - path: /var/lib/immich/upload
      mode: 0755
      overwrite: true
    - path: /var/lib/immich/postgres
      mode: 0755
      overwrite: true
    - path: /var/lib/immich/redis
      mode: 0755
      overwrite: true
    - path: /var/lib/immich/ml-cache
      mode: 0755
      overwrite: true
    - path: /var/lib/immich/backups
      mode: 0755
      overwrite: true
    - path: /etc/immich
      mode: 0755
      overwrite: true
    - path: /etc/nginx
      mode: 0755
      overwrite: true
    - path: /opt/bin
      mode: 0755
      overwrite: true

  files:
    - path: /etc/immich/.env
      mode: 0600
      overwrite: true
      contents:
        inline: |
          IMMICH_VERSION=release
          DB_HOSTNAME=immich-postgres
          DB_USERNAME=postgres
          DB_PASSWORD=postgres
          DB_DATABASE_NAME=immich
          REDIS_HOSTNAME=immich-redis
          UPLOAD_LOCATION=/usr/src/app/upload
          MACHINE_LEARNING_HOST=0.0.0.0
          MACHINE_LEARNING_PORT=3003
          MACHINE_LEARNING_WORKERS=1
          MACHINE_LEARNING_WORKER_TIMEOUT=120

    - path: /etc/nginx/immich.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          server {
              listen 80;
              server_name _;
              client_max_body_size 50000M;

              location / {
                  proxy_pass http://immich-server:2283;
                  proxy_http_version 1.1;
                  proxy_set_header Host $host;
                  proxy_set_header X-Real-IP $remote_addr;
                  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                  proxy_set_header X-Forwarded-Proto $scheme;
                  proxy_set_header Upgrade $http_upgrade;
                  proxy_set_header Connection "upgrade";
                  proxy_read_timeout 86400;
              }
          }

    - path: /opt/bin/immich-backup
      mode: 0755
      overwrite: true
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail

          TIMESTAMP=$(date +%Y%m%d_%H%M%S)
          BACKUP_DIR="/var/lib/immich/backups"
          SNAPSHOT_NAME="immich_backup_${TIMESTAMP}"

          echo "[$(date)] Starting Immich backup..."

          if mountpoint -q /var/lib/immich/upload; then
              btrfs subvolume snapshot /var/lib/immich/upload "${BACKUP_DIR}/${SNAPSHOT_NAME}_upload"
              echo "[$(date)] Upload snapshot created: ${SNAPSHOT_NAME}_upload"
          fi

          if mountpoint -q /var/lib/immich/postgres; then
              btrfs subvolume snapshot /var/lib/immich/postgres "${BACKUP_DIR}/${SNAPSHOT_NAME}_postgres"
              echo "[$(date)] Postgres snapshot created: ${SNAPSHOT_NAME}_postgres"
          fi

          docker exec immich-postgres pg_dump -U postgres immich > "${BACKUP_DIR}/${SNAPSHOT_NAME}_db.sql"
          echo "[$(date)] Database dump created: ${SNAPSHOT_NAME}_db.sql"

          cd "${BACKUP_DIR}"
          ls -t | grep "immich_backup_" | tail -n +8 | xargs -r rm -rf

          echo "[$(date)] Backup complete."

    - path: /opt/bin/immich-health
      mode: 0755
      overwrite: true
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail

          echo "=== Immich Health Check ==="
          echo ""

          for container in immich-postgres immich-redis immich-server immich-ml immich-proxy; do
              if docker ps --format "{{.Names}}" | grep -q "^${container}$"; then
                  echo "✓ ${container} is running"
              else
                  echo "✗ ${container} is NOT running"
              fi
          done

          echo ""
          echo "=== Disk Usage ==="
          df -h /var/lib/immich

          echo ""
          echo "=== Memory Usage ==="
          free -h

          echo ""
          echo "=== Immich API Status ==="
          curl -s http://localhost:2283/api/server-info/ping || echo "API not responding"

    - path: /etc/systemd/system/immich-backup.timer
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Unit]
          Description=Daily Immich backup

          [Timer]
          OnCalendar=daily
          Persistent=true
          RandomizedDelaySec=3600

          [Install]
          WantedBy=timers.target

    - path: /etc/logrotate.d/immich
      mode: 0644
      overwrite: true
      contents:
        inline: |
          /var/log/immich/*.log {
              daily
              rotate 7
              compress
              delaycompress
              missingok
              notifempty
              create 0644 root root
          }

systemd:
  units:
    - name: immich-network.service
      enabled: true
      contents: |
        [Unit]
        Description=Create Immich Docker network
        After=docker.service
        Requires=docker.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/docker network create immich-net 2>/dev/null || true
        ExecStop=/usr/bin/docker network rm immich-net 2>/dev/null || true

        [Install]
        WantedBy=multi-user.target

    - name: immich-postgres.service
      enabled: true
      contents: |
        [Unit]
        Description=Immich PostgreSQL Database
        After=immich-network.service
        Requires=immich-network.service

        [Service]
        Restart=always
        RestartSec=5
        ExecStartPre=-/usr/bin/docker kill immich-postgres
        ExecStartPre=-/usr/bin/docker rm immich-postgres
        ExecStartPre=/usr/bin/docker pull tensorchord/pgvecto-rs:pg14-v0.2.0
        ExecStart=/usr/bin/docker run \
          --name immich-postgres \
          --network immich-net \
          --env POSTGRES_PASSWORD=postgres \
          --env POSTGRES_USER=postgres \
          --env POSTGRES_DB=immich \
          --volume /var/lib/immich/postgres:/var/lib/postgresql/data:Z \
          --health-cmd "pg_isready -U postgres" \
          --health-interval 10s \
          --health-timeout 5s \
          --health-retries 5 \
          tensorchord/pgvecto-rs:pg14-v0.2.0
        ExecStop=/usr/bin/docker stop -t 30 immich-postgres
        ExecStopPost=-/usr/bin/docker rm immich-postgres

        [Install]
        WantedBy=multi-user.target

    - name: immich-redis.service
      enabled: true
      contents: |
        [Unit]
        Description=Immich Redis Cache
        After=immich-network.service
        Requires=immich-network.service

        [Service]
        Restart=always
        RestartSec=5
        ExecStartPre=-/usr/bin/docker kill immich-redis
        ExecStartPre=-/usr/bin/docker rm immich-redis
        ExecStartPre=/usr/bin/docker pull redis:6.2-alpine
        ExecStart=/usr/bin/docker run \
          --name immich-redis \
          --network immich-net \
          --volume /var/lib/immich/redis:/data:Z \
          --health-cmd "redis-cli ping || exit 1" \
          --health-interval 10s \
          --health-timeout 5s \
          --health-retries 5 \
          redis:6.2-alpine \
          redis-server --appendonly yes
        ExecStop=/usr/bin/docker stop -t 30 immich-redis
        ExecStopPost=-/usr/bin/docker rm immich-redis

        [Install]
        WantedBy=multi-user.target

    - name: immich-ml.service
      enabled: true
      contents: |
        [Unit]
        Description=Immich Machine Learning
        After=immich-network.service
        Requires=immich-network.service

        [Service]
        Restart=always
        RestartSec=5
        ExecStartPre=-/usr/bin/docker kill immich-ml
        ExecStartPre=-/usr/bin/docker rm immich-ml
        ExecStartPre=/usr/bin/docker pull ghcr.io/immich-app/immich-machine-learning:release
        ExecStart=/usr/bin/docker run \
          --name immich-ml \
          --network immich-net \
          --env MACHINE_LEARNING_HOST=0.0.0.0 \
          --env MACHINE_LEARNING_PORT=3003 \
          --env MACHINE_LEARNING_WORKERS=1 \
          --env MACHINE_LEARNING_WORKER_TIMEOUT=120 \
          --volume /var/lib/immich/ml-cache:/cache:Z \
          ghcr.io/immich-app/immich-machine-learning:release
        ExecStop=/usr/bin/docker stop -t 30 immich-ml
        ExecStopPost=-/usr/bin/docker rm immich-ml

        [Install]
        WantedBy=multi-user.target

    - name: immich-server.service
      enabled: true
      contents: |
        [Unit]
        Description=Immich Server
        After=immich-postgres.service immich-redis.service immich-ml.service
        Requires=immich-postgres.service immich-redis.service immich-ml.service

        [Service]
        Restart=always
        RestartSec=10
        ExecStartPre=-/usr/bin/docker kill immich-server
        ExecStartPre=-/usr/bin/docker rm immich-server
        ExecStartPre=/usr/bin/docker pull ghcr.io/immich-app/immich-server:release
        ExecStart=/usr/bin/docker run \
          --name immich-server \
          --network immich-net \
          --publish 2283:2283 \
          --env DB_HOSTNAME=immich-postgres \
          --env DB_USERNAME=postgres \
          --env DB_PASSWORD=postgres \
          --env DB_DATABASE_NAME=immich \
          --env REDIS_HOSTNAME=immich-redis \
          --env UPLOAD_LOCATION=/usr/src/app/upload \
          --env MACHINE_LEARNING_HOST=immich-ml \
          --env MACHINE_LEARNING_PORT=3003 \
          --volume /var/lib/immich/upload:/usr/src/app/upload:Z \
          --health-cmd "curl -f http://localhost:2283/api/server-info/ping || exit 1" \
          --health-interval 30s \
          --health-timeout 10s \
          --health-retries 3 \
          ghcr.io/immich-app/immich-server:release
        ExecStop=/usr/bin/docker stop -t 30 immich-server
        ExecStopPost=-/usr/bin/docker rm immich-server

        [Install]
        WantedBy=multi-user.target

    - name: immich-proxy.service
      enabled: true
      contents: |
        [Unit]
        Description=Immich Nginx Reverse Proxy
        After=immich-server.service
        Requires=immich-server.service

        [Service]
        Restart=always
        RestartSec=5
        ExecStartPre=-/usr/bin/docker kill immich-proxy
        ExecStartPre=-/usr/bin/docker rm immich-proxy
        ExecStartPre=/usr/bin/docker pull nginx:alpine
        ExecStart=/usr/bin/docker run \
          --name immich-proxy \
          --network immich-net \
          --publish 80:80 \
          --volume /etc/nginx/immich.conf:/etc/nginx/conf.d/default.conf:ro,Z \
          nginx:alpine
        ExecStop=/usr/bin/docker stop -t 10 immich-proxy
        ExecStopPost=-/usr/bin/docker rm immich-proxy

        [Install]
        WantedBy=multi-user.target

    - name: immich-backup.service
      enabled: true
      contents: |
        [Unit]
        Description=Immich Backup
        After=immich-postgres.service

        [Service]
        Type=oneshot
        ExecStart=/opt/bin/immich-backup
        StandardOutput=journal
        StandardError=journal

        [Install]
        WantedBy=multi-user.target

    - name: immich-backup.timer
      enabled: true