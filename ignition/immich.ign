{"ignition":{"version":"3.4.0"},"passwd":{"users":[{"name":"core","sshAuthorizedKeys":["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... your@email"]}]},"storage":{"directories":[{"overwrite":true,"path":"/var/lib/immich","mode":493},{"overwrite":true,"path":"/var/lib/immich/upload","mode":493},{"overwrite":true,"path":"/var/lib/immich/postgres","mode":493},{"overwrite":true,"path":"/var/lib/immich/redis","mode":493},{"overwrite":true,"path":"/var/lib/immich/ml-cache","mode":493},{"overwrite":true,"path":"/var/lib/immich/backups","mode":493},{"overwrite":true,"path":"/etc/immich","mode":493},{"overwrite":true,"path":"/etc/nginx","mode":493},{"overwrite":true,"path":"/opt/bin","mode":493}],"files":[{"overwrite":true,"path":"/etc/immich/.env","contents":{"compression":"gzip","source":"data:;base64,H4sIAAAAAAAC/3TOQWvDMAwF4Lv/y5Z0PfugxmIxi60gOevRhNZsgZYae/3/ozl1hKHb++DpWeds18dPZLHkdUmXNNekzCH2JMGDQ71cr8vp+yXf6s9XSfVhkyCv9hyOIHIkNn9CAwEOIBifqhSjsbJ5UNJ5qWoaBwITB+ogPBY191qaWk7NnHNzz5fbfFYOut56jAMCe+vf1yrdvq631ZE46H3b7rd0JP5AFr37j2KwDmkKevfWqt8AAAD//7Zc1VAtAQAA"},"mode":384},{"overwrite":true,"path":"/etc/nginx/immich.conf","contents":{"compression":"gzip","source":"data:;base64,"},"mode":420},{"overwrite":true,"path":"/opt/bin/immich-backup","contents":{"compression":"gzip","source":"data:;base64,"},"mode":493},{"overwrite":true,"path":"/opt/bin/immich-health","contents":{"compression":"gzip","source":"data:;base64,"},"mode":493},{"overwrite":true,"path":"/etc/systemd/system/immich-backup.timer","contents":{"compression":"","source":"data:,%5BUnit%5D%0ADescription%3DDaily%20Immich%20backup%0A%0A%5BTimer%5D%0AOnCalendar%3Ddaily%0APersistent%3Dtrue%0ARandomizedDelaySec%3D3600%0A%0A%5BInstall%5D%0AWantedBy%3Dtimers.target%0A"},"mode":420},{"overwrite":true,"path":"/etc/logrotate.d/immich","contents":{"compression":"gzip","source":"data:;base64,H4sIAAAAAAAC/1SMwQoCMQxE7/2KnD1YD4t+T6mxBpudJQ3CIv67mJ72MswbhpffxXJHy6Iq9ZlP545Gn0REdC/S92gGL850C6jQzXiM+eFe9sOiMoasDa+gFS4P1s2nqBr/RZfrspABHpG+6RcAAP//kwEFNIcAAAA="},"mode":420}]},"systemd":{"units":[{"contents":"[Unit]\nDescription=Create Immich Docker network\nAfter=docker.service\nRequires=docker.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/bin/docker network create immich-net 2\u003e/dev/null || true\nExecStop=/usr/bin/docker network rm immich-net 2\u003e/dev/null || true\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"immich-network.service"},{"contents":"[Unit]\nDescription=Immich PostgreSQL Database\nAfter=immich-network.service\nRequires=immich-network.service\n\n[Service]\nRestart=always\nRestartSec=5\nExecStartPre=-/usr/bin/docker kill immich-postgres\nExecStartPre=-/usr/bin/docker rm immich-postgres\nExecStartPre=/usr/bin/docker pull tensorchord/pgvecto-rs:pg14-v0.2.0\nExecStart=/usr/bin/docker run \\\n  --name immich-postgres \\\n  --network immich-net \\\n  --env POSTGRES_PASSWORD=postgres \\\n  --env POSTGRES_USER=postgres \\\n  --env POSTGRES_DB=immich \\\n  --volume /var/lib/immich/postgres:/var/lib/postgresql/data:Z \\\n  --health-cmd \"pg_isready -U postgres\" \\\n  --health-interval 10s \\\n  --health-timeout 5s \\\n  --health-retries 5 \\\n  tensorchord/pgvecto-rs:pg14-v0.2.0\nExecStop=/usr/bin/docker stop -t 30 immich-postgres\nExecStopPost=-/usr/bin/docker rm immich-postgres\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"immich-postgres.service"},{"contents":"[Unit]\nDescription=Immich Redis Cache\nAfter=immich-network.service\nRequires=immich-network.service\n\n[Service]\nRestart=always\nRestartSec=5\nExecStartPre=-/usr/bin/docker kill immich-redis\nExecStartPre=-/usr/bin/docker rm immich-redis\nExecStartPre=/usr/bin/docker pull redis:6.2-alpine\nExecStart=/usr/bin/docker run \\\n  --name immich-redis \\\n  --network immich-net \\\n  --volume /var/lib/immich/redis:/data:Z \\\n  --health-cmd \"redis-cli ping || exit 1\" \\\n  --health-interval 10s \\\n  --health-timeout 5s \\\n  --health-retries 5 \\\n  redis:6.2-alpine \\\n  redis-server --appendonly yes\nExecStop=/usr/bin/docker stop -t 30 immich-redis\nExecStopPost=-/usr/bin/docker rm immich-redis\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"immich-redis.service"},{"contents":"[Unit]\nDescription=Immich Machine Learning\nAfter=immich-network.service\nRequires=immich-network.service\n\n[Service]\nRestart=always\nRestartSec=5\nExecStartPre=-/usr/bin/docker kill immich-ml\nExecStartPre=-/usr/bin/docker rm immich-ml\nExecStartPre=/usr/bin/docker pull ghcr.io/immich-app/immich-machine-learning:release\nExecStart=/usr/bin/docker run \\\n  --name immich-ml \\\n  --network immich-net \\\n  --env MACHINE_LEARNING_HOST=0.0.0.0 \\\n  --env MACHINE_LEARNING_PORT=3003 \\\n  --env MACHINE_LEARNING_WORKERS=1 \\\n  --env MACHINE_LEARNING_WORKER_TIMEOUT=120 \\\n  --volume /var/lib/immich/ml-cache:/cache:Z \\\n  ghcr.io/immich-app/immich-machine-learning:release\nExecStop=/usr/bin/docker stop -t 30 immich-ml\nExecStopPost=-/usr/bin/docker rm immich-ml\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"immich-ml.service"},{"contents":"[Unit]\nDescription=Immich Server\nAfter=immich-postgres.service immich-redis.service immich-ml.service\nRequires=immich-postgres.service immich-redis.service immich-ml.service\n\n[Service]\nRestart=always\nRestartSec=10\nExecStartPre=-/usr/bin/docker kill immich-server\nExecStartPre=-/usr/bin/docker rm immich-server\nExecStartPre=/usr/bin/docker pull ghcr.io/immich-app/immich-server:release\nExecStart=/usr/bin/docker run \\\n  --name immich-server \\\n  --network immich-net \\\n  --publish 2283:2283 \\\n  --env DB_HOSTNAME=immich-postgres \\\n  --env DB_USERNAME=postgres \\\n  --env DB_PASSWORD=postgres \\\n  --env DB_DATABASE_NAME=immich \\\n  --env REDIS_HOSTNAME=immich-redis \\\n  --env UPLOAD_LOCATION=/usr/src/app/upload \\\n  --env MACHINE_LEARNING_HOST=immich-ml \\\n  --env MACHINE_LEARNING_PORT=3003 \\\n  --volume /var/lib/immich/upload:/usr/src/app/upload:Z \\\n  --health-cmd \"curl -f http://localhost:2283/api/server-info/ping || exit 1\" \\\n  --health-interval 30s \\\n  --health-timeout 10s \\\n  --health-retries 3 \\\n  ghcr.io/immich-app/immich-server:release\nExecStop=/usr/bin/docker stop -t 30 immich-server\nExecStopPost=-/usr/bin/docker rm immich-server\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"immich-server.service"},{"contents":"[Unit]\nDescription=Immich Nginx Reverse Proxy\nAfter=immich-server.service\nRequires=immich-server.service\n\n[Service]\nRestart=always\nRestartSec=5\nExecStartPre=-/usr/bin/docker kill immich-proxy\nExecStartPre=-/usr/bin/docker rm immich-proxy\nExecStartPre=/usr/bin/docker pull nginx:alpine\nExecStart=/usr/bin/docker run \\\n  --name immich-proxy \\\n  --network immich-net \\\n  --publish 80:80 \\\n  --volume /etc/nginx/immich.conf:/etc/nginx/conf.d/default.conf:ro,Z \\\n  nginx:alpine\nExecStop=/usr/bin/docker stop -t 10 immich-proxy\nExecStopPost=-/usr/bin/docker rm immich-proxy\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"immich-proxy.service"},{"contents":"[Unit]\nDescription=Immich Backup\nAfter=immich-postgres.service\n\n[Service]\nType=oneshot\nExecStart=/opt/bin/immich-backup\nStandardOutput=journal\nStandardError=journal\n\n[Install]\nWantedBy=multi-user.target\n","enabled":true,"name":"immich-backup.service"},{"enabled":true,"name":"immich-backup.timer"}]}}
